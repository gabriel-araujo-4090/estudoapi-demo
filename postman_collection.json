{
  "info": {
    "_postman_id": "e414b553-3dc4-4e34-ae68-cba5b5e1d81d",
    "name": "Demo API - Tasks",
    "description": "Requests para os endpoints do TaskController.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Criar tarefa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Estudar Spring\",\n  \"description\": \"Criar uma API de tarefas\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "create"
          ]
        },
        "description": "Cria uma tarefa e guarda o ID retornado na variável taskId."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const task = pm.response.json();",
              "    if (task.id !== undefined) {",
              "        pm.collectionVariables.set('taskId', task.id);",
              "    }",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Listar tarefas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks"
          ]
        }
      }
    },
    {
      "name": "Buscar tarefa por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}"
          ]
        }
      }
    },
    {
      "name": "Atualizar tarefa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": {{taskId}},\n  \"title\": \"Estudar Spring Boot\",\n  \"description\": \"Tarefa atualizada pelo Postman\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/tasks/update",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "update"
          ]
        }
      }
    },
    {
      "name": "Concluir tarefa",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}/complete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}",
            "complete"
          ]
        }
      }
    },
    {
      "name": "Excluir tarefa",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/tasks/{{taskId}}/delete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tasks",
            "{{taskId}}",
            "delete"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
